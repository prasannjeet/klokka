# Copy to .env (gitignored). Values here are LOCAL defaults for docker-compose.yml and the API in dev
# mode; staging and production values live only in Coolify. Never commit a real secret.

# ---- docker compose (Postgres 18 + Mailpit) ----
KLOKKA_DB_NAME=klokka
KLOKKA_DB_USER=klokka
KLOKKA_DB_PASSWORD=klokka
KLOKKA_PG_PORT=5434
KLOKKA_MAILPIT_UI_PORT=8025
KLOKKA_MAILPIT_SMTP_PORT=1025

# ---- API (apps/api/service), read by application.properties ----
# Database. Leave KLOKKA_DB_URL unset in dev mode to let Quarkus Dev Services start its own Postgres 18.
KLOKKA_DB_URL=jdbc:postgresql://localhost:5434/klokka
# The runtime role (DML only) and the migration role (owns DDL, used by Flyway). Locally both are the
# compose user; on staging they are klokka_runtime and klokka_migrate.
KLOKKA_DB_MIGRATE_USER=klokka
KLOKKA_DB_MIGRATE_PASSWORD=klokka

# Auth (Logto, OIDC bearer). The issuer is <logto>/oidc, the audience is the API resource indicator,
# the JWKS URL is <logto>/oidc/jwks. Real values come from the Klokka Logto on staging (docs/INFRA.md).
KLOKKA_AUTH_ISSUER=https://klokka-logto.coolify.ooguy.com/oidc
KLOKKA_AUTH_AUDIENCE=https://api.klokka.invalid
KLOKKA_AUTH_JWKS=https://klokka-logto.coolify.ooguy.com/oidc/jwks

# Logto Management API (M2M app), only needed for invitations and workspace creation.
KLOKKA_LOGTO_ENDPOINT=https://klokka-logto.coolify.ooguy.com
KLOKKA_LOGTO_M2M_CLIENT_ID=
KLOKKA_LOGTO_M2M_CLIENT_SECRET=
KLOKKA_LOGTO_WEBHOOK_SIGNING_KEY=

# Mail. Locally Mailpit; on staging Migadu (smtp.migadu.com:587 STARTTLS).
KLOKKA_MAIL_HOST=localhost
KLOKKA_MAIL_PORT=1025
KLOKKA_MAIL_USERNAME=
KLOKKA_MAIL_PASSWORD=
KLOKKA_MAIL_FROM=Klokka <no-reply@klokka.invalid>
KLOKKA_MAIL_START_TLS=DISABLED

# Where the web app lives (invite links, share cards) and push.
KLOKKA_WEB_BASE_URL=http://localhost:3000
KLOKKA_EXPO_ACCESS_TOKEN=

# ---- web (apps/web) ----
API_BASE_URL=http://localhost:8080/v1
LOGTO_ENDPOINT=https://klokka-logto.coolify.ooguy.com
LOGTO_APP_ID=
LOGTO_APP_SECRET=
LOGTO_COOKIE_SECRET=change-me-to-32-random-characters
LOGTO_BASE_URL=http://localhost:3000
LOGTO_API_RESOURCE=https://api.klokka.invalid

# ---- mobile (apps/mobile), read at Metro time ----
EXPO_PUBLIC_API_BASE_URL=http://192.168.0.16:8080/v1
EXPO_PUBLIC_LOGTO_ENDPOINT=https://klokka-logto.coolify.ooguy.com
EXPO_PUBLIC_LOGTO_APP_ID=
EXPO_PUBLIC_LOGTO_API_RESOURCE=https://api.klokka.invalid
