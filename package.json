{
  "name": "klokka",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Klokka monorepo: the Quarkus API (Maven, not a workspace), the Next.js web app and landing site, the Expo app, and the shared packages.",
  "license": "MIT",
  "workspaces": [
    "apps/web",
    "apps/landing",
    "apps/mobile",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check": "npm run check --workspaces --if-present",
    "generate": "npm run generate --workspaces --if-present",
    "lint": "eslint . && prettier --check . && bash scripts/check-em-dash.sh",
    "format": "prettier --write .",
    "mock:api": "prism mock apps/api/contract/src/main/openapi/openapi.yaml -p 4010 -h 0.0.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@stoplight/prism-cli": "^5.16.0",
    "@types/node": "^26.6.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "3.9.9",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
