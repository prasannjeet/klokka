# Copy to apps/mobile/.env (gitignored). Read by Metro at bundle time (EXPO_PUBLIC_*) and by
# app.config.ts at prebuild/build time (EAS_PROJECT_ID). A JS reload picks up EXPO_PUBLIC_* changes;
# EAS_PROJECT_ID is baked into the APK, so changing it needs a new build. Nothing here is secret.

# Where /v1 is called. Staging (default for the phone loop):
EXPO_PUBLIC_API_BASE_URL=https://klokka-api.coolify.ooguy.com/v1
# The Prism mock on this host (paths WITHOUT /v1; a phone cannot reach localhost, use the LAN IP):
# EXPO_PUBLIC_API_BASE_URL=http://192.168.0.16:4011

# Klokka's own staging Logto (docs/INFRA.md section 4). The native app is a public PKCE client.
EXPO_PUBLIC_LOGTO_ENDPOINT=https://klokka-logto.coolify.ooguy.com
EXPO_PUBLIC_LOGTO_APP_ID=1uhtt4uj8f0aevtgf6g3b
EXPO_PUBLIC_LOGTO_API_RESOURCE=https://api.klokka.app

# Umami usage analytics (CHQ-201), optional as a pair; leave both empty to send nothing. Staging phone app:
# EXPO_PUBLIC_UMAMI_URL=https://umami-a4zjdk8zgumdaqfxh3el0gtq.coolify.ooguy.com
# EXPO_PUBLIC_UMAMI_WEBSITE_ID=33d7ba05-164a-41e3-8723-59ebbea29c31

# The EAS project id from .agents/local-credentials/expo.json (needed by getExpoPushTokenAsync).
EAS_PROJECT_ID=
