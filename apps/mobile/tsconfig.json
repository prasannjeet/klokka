{
  "extends": "expo/tsconfig.base",
  // noUnusedLocals/noUnusedParameters are deliberately absent: the graph includes the generated
  // @klokka/api-client, which trips them and cannot be edited. The root ESLint config catches unused
  // declarations in authored code at 'error'.
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "allowImportingTsExtensions": true,
    "types": ["jest", "node"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["node_modules", "android", "ios", "plugins"]
}
