# apps/web runtime configuration. Copy to .env.local (gitignored) for `npm run dev`; staging and production
# set the same names as Coolify env vars. Every value is read at request time, never at build time, except
# NEXT_PUBLIC_SITE_URL below.

# The Klokka API including its prefix. Real API: https://klokka-api.coolify.ooguy.com/v1
# Prism mock (`npm run mock:api` at the repo root): http://localhost:4010 (no /v1 prefix there).
KLOKKA_API_BASE_URL=http://localhost:4010
# The Logto API resource indicator the access token is issued for (docs/INFRA.md section 4).
KLOKKA_API_RESOURCE=https://api.klokka.app

# Logto, traditional web app `klokka-web` (docs/INFRA.md section 4). The secret lives in
# .agents/local-credentials/logto.json locally and in Coolify on staging.
LOGTO_ENDPOINT=https://klokka-logto.coolify.ooguy.com
LOGTO_APP_ID=
LOGTO_APP_SECRET=
# Where the browser reaches this app; Logto sends it back to <this>/callback, so it must be registered there.
# LAN development: http://192.168.0.16:3000
LOGTO_BASE_URL=http://localhost:3000
# At least 32 random characters, never reused between environments.
LOGTO_COOKIE_SECRET=

# Build time only (Next.js inlines NEXT_PUBLIC_*; a Docker build argument, see image.sh): the marketing site that
# serves the share-preview image <site>/og/home-<locale>.jpg. Unset means staging's landing.
# NEXT_PUBLIC_SITE_URL=https://klokka.coolify.ooguy.com

# Optional: the signed Android APK offered after an invitation is accepted. Unset hides the link.
KLOKKA_ANDROID_APK_URL=https://nexus.coolify.ooguy.com/repository/klokka-downloads/android/klokka-latest.apk

# Optional as a pair: Umami usage analytics (CHQ-201). Neither set means no tracking. Staging web app:
# KLOKKA_UMAMI_URL=https://umami-a4zjdk8zgumdaqfxh3el0gtq.coolify.ooguy.com
# KLOKKA_UMAMI_WEBSITE_ID=f0b48f6b-5703-4c05-97d9-956552a2b262

# Development only (ignored when NODE_ENV=production): treat every request as signed in without Logto,
# for driving the UI against the Prism mock. The persona cookie `klokka_dev_persona`
# (employer | employee | operator) picks which role /me reports.
# KLOKKA_DEV_FAKE_SESSION=1
