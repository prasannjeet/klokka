{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node"],
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./src/*"] },
    "verbatimModuleSyntax": false,
    "exactOptionalPropertyTypes": false,
    "noImplicitOverride": false,
    "allowJs": false,
    "incremental": true
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "e2e/**/*.ts",
    "*.config.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules", ".next/standalone"]
}
