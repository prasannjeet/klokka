<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.prasannjeet.klokka</groupId>
        <artifactId>klokka-api-parent</artifactId>
        <version>1.3.0</version>
    </parent>

    <artifactId>klokka-api-contract</artifactId>
    <packaging>jar</packaging>
    <name>Klokka API contract</name>
    <description>
        The OpenAPI contract (src/main/openapi/openapi.yaml) and the Jakarta REST server interfaces and models generated
        from it with openapi-generator jaxrs-spec (library quarkus, interfaceOnly). Published to Nexus so the service and,
        later, other JVM consumers depend on the same artifact (docs/DECISIONS.md D13). The yaml itself ships in the jar
        as META-INF/openapi.yaml so the service can serve it verbatim at /q/openapi.
    </description>

    <dependencies>
        <!-- Everything the generated interfaces and models import; all managed by the Quarkus BOM. -->
        <dependency>
            <groupId>jakarta.ws.rs</groupId>
            <artifactId>jakarta.ws.rs-api</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.eclipse.microprofile.openapi</groupId>
            <artifactId>microprofile-openapi-api</artifactId>
        </dependency>
        <!-- org.jboss.resteasy.reactive.ResponseStatus on every generated operation. -->
        <dependency>
            <groupId>io.quarkus.resteasy.reactive</groupId>
            <artifactId>resteasy-reactive-common</artifactId>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/openapi</directory>
                <targetPath>META-INF</targetPath>
                <includes>
                    <include>openapi.yaml</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <!-- A Jandex index in the jar, so Quarkus sees the generated @Path interfaces in this external dependency
                 (without it the resources implementing them are never registered and every route is a 404). -->
            <plugin>
                <groupId>io.smallrye</groupId>
                <artifactId>jandex-maven-plugin</artifactId>
                <version>${jandex-plugin.version}</version>
                <executions>
                    <execution>
                        <id>make-index</id>
                        <goals>
                            <goal>jandex</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.openapitools</groupId>
                <artifactId>openapi-generator-maven-plugin</artifactId>
                <executions>
                    <!-- The exact configuration proven in docs/research/backend-and-infra.md section 2. sourceFolder must be
                         set explicitly or the plugin registers src/main/java under the output dir while jaxrs-spec writes to
                         src/gen/java. -->
                    <execution>
                        <id>gen-server</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <inputSpec>${project.basedir}/src/main/openapi/openapi.yaml</inputSpec>
                            <generatorName>jaxrs-spec</generatorName>
                            <apiPackage>com.prasannjeet.klokka.contract.api</apiPackage>
                            <modelPackage>com.prasannjeet.klokka.contract.model</modelPackage>
                            <generateApiTests>false</generateApiTests>
                            <generateModelTests>false</generateModelTests>
                            <generateApiDocumentation>false</generateApiDocumentation>
                            <generateModelDocumentation>false</generateModelDocumentation>
                            <generateSupportingFiles>false</generateSupportingFiles>
                            <configOptions>
                                <library>quarkus</library>
                                <interfaceOnly>true</interfaceOnly>
                                <useJakartaEe>true</useJakartaEe>
                                <useMicroProfileOpenAPIAnnotations>true</useMicroProfileOpenAPIAnnotations>
                                <useSwaggerAnnotations>false</useSwaggerAnnotations>
                                <useBeanValidation>true</useBeanValidation>
                                <dateLibrary>java8</dateLibrary>
                                <openApiNullable>false</openApiNullable>
                                <generatePom>false</generatePom>
                                <useTags>true</useTags>
                                <returnResponse>false</returnResponse>
                                <sourceFolder>src/gen/java</sourceFolder>
                            </configOptions>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
