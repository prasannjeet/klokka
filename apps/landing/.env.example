# Baked into the build (NEXT_PUBLIC_*), so set them at BUILD time: the Dockerfile takes them as build args.
# Absolute origin of this site: canonical URLs, hreflang, the sitemap, og:url.
NEXT_PUBLIC_SITE_URL=https://klokka.coolify.ooguy.com
# The web app: "Create your workspace" and "Log in".
NEXT_PUBLIC_APP_URL=https://klokka-app.coolify.ooguy.com
# The signed Android release APK on Nexus (raw), linked by "Get the Android app".
NEXT_PUBLIC_APK_URL=https://nexus.coolify.ooguy.com/repository/klokka-downloads/klokka-latest.apk
